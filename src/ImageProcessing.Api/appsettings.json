{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Root": "storage"
  },
  "Processing": {
    "MaxUploadBytes": 52428800,
    "QueueCapacity": 128,
    "MaxConcurrency": 2,
    "JobTimeout": "00:05:00",
    "Retention": "24:00:00",
    "CleanupInterval": "00:15:00",
    "QueueHighWatermark": 0.9,
    "ShutdownDrainTimeout": "00:00:30"
  }
}
